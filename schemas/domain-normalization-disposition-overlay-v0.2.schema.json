{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/singularity-studies/observatory/schemas/domain-normalization-disposition-overlay-v0.2.schema.json",
  "title": "Domain normalization disposition overlay v0.2",
  "description": "Prospective post-closure current-state overlay; Task 105D4 creates no instance.",
  "type": "object",
  "x-instrument-version": "0.5.0-draft",
  "additionalProperties": false,
  "required": [
    "normalization_disposition_overlay_id",
    "instrument_version",
    "materialization_protocol",
    "normalization_completion",
    "normalization_codebook",
    "universe_boundary",
    "source_extractions",
    "pass1_records",
    "pass2a_record",
    "pass2b_record",
    "residual_clarification",
    "closure_amendment",
    "closure_application",
    "status",
    "entries",
    "rationale",
    "uncertainty",
    "recorded_at"
  ],
  "properties": {
    "normalization_disposition_overlay_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]+$"
    },
    "instrument_version": {"const": "0.5.0-draft"},
    "materialization_protocol": {"$ref": "#/$defs/materialization_protocol"},
    "normalization_completion": {"$ref": "#/$defs/normalization_completion"},
    "normalization_codebook": {"$ref": "#/$defs/normalization_codebook"},
    "universe_boundary": {"$ref": "#/$defs/universe_boundary"},
    "source_extractions": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "uniqueItems": true,
      "items": {
        "oneOf": [
          {"$ref": "#/$defs/ford_extraction"},
          {"$ref": "#/$defs/isic_extraction"},
          {"$ref": "#/$defs/ipc_extraction"},
          {"$ref": "#/$defs/cofog_extraction"}
        ]
      }
    },
    "pass1_records": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "uniqueItems": true,
      "items": {
        "oneOf": [
          {"$ref": "#/$defs/ford_pass1"},
          {"$ref": "#/$defs/isic_pass1"},
          {"$ref": "#/$defs/ipc_pass1"},
          {"$ref": "#/$defs/cofog_pass1"}
        ]
      }
    },
    "pass2a_record": {"$ref": "#/$defs/pass2a_record"},
    "pass2b_record": {"$ref": "#/$defs/pass2b_record"},
    "residual_clarification": {"$ref": "#/$defs/residual_clarification"},
    "closure_amendment": {"$ref": "#/$defs/closure_amendment"},
    "closure_application": {"$ref": "#/$defs/closure_application"},
    "status": {"type": "string", "enum": ["partial", "complete"]},
    "entries": {
      "type": "array",
      "minItems": 1,
      "maxItems": 330,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/disposition_entry"}
    },
    "rationale": {"type": "string", "minLength": 1},
    "uncertainty": {"type": "string", "minLength": 1},
    "recorded_at": {"type": "string", "format": "date-time"}
  },
  "allOf": [
    {
      "if": {
        "properties": {"status": {"const": "complete"}},
        "required": ["status"]
      },
      "then": {
        "properties": {
          "entries": {
            "minItems": 330,
            "maxItems": 330,
            "items": {
              "allOf": [
                {"$ref": "#/$defs/disposition_entry"},
                {
                  "not": {
                    "properties": {
                      "normalization_disposition": {"const": "unresolved"}
                    },
                    "required": ["normalization_disposition"]
                  }
                }
              ]
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "materialization_protocol": {
      "allOf": [
        {"$ref": "#/$defs/artifact"},
        {
          "properties": {
            "path": {"const": "domain-universe/NORMALIZATION_MATERIALIZATION_PROTOCOL_v0.2.md"},
            "sha256": {"const": "cd34e1147970e6353cecf64eb710a4a596674005116bb30db839b5e267bdae4a"}
          }
        }
      ]
    },
    "normalization_completion": {
      "allOf": [
        {"$ref": "#/$defs/artifact"},
        {
          "properties": {
            "path": {"const": "domain-universe/normalization/completion/normalization-completion-v0.1.json"},
            "sha256": {"const": "b7aa6d86669c3290cb2572f4aa0a1542440ebf9712621b83c4823079cd18f2e2"}
          }
        }
      ]
    },
    "normalization_codebook": {
      "allOf": [
        {"$ref": "#/$defs/artifact"},
        {
          "properties": {
            "path": {"const": "domain-universe/NORMALIZATION_CODEBOOK.md"},
            "sha256": {"const": "bc0f2d62c8b6219911b759e8a69332021cb471167a9e3fdbc6a4b5b8918b69e4"}
          }
        }
      ]
    },
    "universe_boundary": {
      "allOf": [
        {"$ref": "#/$defs/artifact"},
        {
          "properties": {
            "path": {"const": "domain-universe/boundaries/du-boundary-v0.1.json"},
            "sha256": {"const": "d60ac188138cfc638b53ccfa05635e5d65372586d57553ff55fa7895040a6581"}
          }
        }
      ]
    },
    "ford_extraction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"const": "domain-universe/extractions/oecd-ford-frascati-2015-second-level.json"},
        "sha256": {"const": "eb376d7c4da77078cdfdc9772daf166eb3bf6e11a973df0241b1fb782128b6e4"}
      }
    },
    "isic_extraction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"const": "domain-universe/extractions/un-isic-rev5-division.json"},
        "sha256": {"const": "569b5ac552ffdf0f5fcf993e8918181a9005c2c9d6e4b19c701126d3b1f2b9b9"}
      }
    },
    "ipc_extraction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"const": "domain-universe/extractions/wipo-ipc-2026-01-class.json"},
        "sha256": {"const": "e8cf7903547eb245a2e4447b1221aa73df541c1da4a748e5127a232a87efe33c"}
      }
    },
    "cofog_extraction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"const": "domain-universe/extractions/un-cofog-1999-group.json"},
        "sha256": {"const": "0b5061f4a1029fe28e1ccb5a1c3f5563371e876f983bb6b6365883b7c875e3dd"}
      }
    },
    "ford_pass1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"const": "domain-universe/normalization/pass1/oecd-ford-frascati-2015-pass1.json"},
        "sha256": {"const": "d62c8f899b3b966381cdd693adcb1e9bf89cd6210474b8d30a4550889fb5612d"}
      }
    },
    "isic_pass1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"const": "domain-universe/normalization/pass1/un-isic-rev5-pass1.json"},
        "sha256": {"const": "7b02e4a2864076700c2d1d26910ef2b591e7771007d4819670f8c30a70d82cb3"}
      }
    },
    "ipc_pass1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"const": "domain-universe/normalization/pass1/wipo-ipc-2026-01-pass1.json"},
        "sha256": {"const": "8ca43b8888fe64d5f96c663dead2a2e37b8da9f687af1ee42188c21926723a9a"}
      }
    },
    "cofog_pass1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"const": "domain-universe/normalization/pass1/un-cofog-1999-pass1.json"},
        "sha256": {"const": "e95466d6e82c20f4d0f082e914509c080ebb962182c09fce20faad0786f226cc"}
      }
    },
    "pass2a_record": {
      "allOf": [
        {"$ref": "#/$defs/artifact"},
        {
          "properties": {
            "path": {"const": "domain-universe/normalization/pass2a/equivalence-groups-v0.1.json"},
            "sha256": {"const": "e830a1cf566888badc31776ad263077208dae458d5f9e53f0783a5bdd778c822"}
          }
        }
      ]
    },
    "pass2b_record": {
      "allOf": [
        {"$ref": "#/$defs/artifact"},
        {
          "properties": {
            "path": {"const": "domain-universe/normalization/pass2b/deferred-equivalence-adjudication-v0.1.json"},
            "sha256": {"const": "4ec539b016e35cd7ec6f0545160d662a508472e4b664e843e8a7a1d8c227d012"}
          }
        }
      ]
    },
    "residual_clarification": {
      "allOf": [
        {"$ref": "#/$defs/artifact"},
        {
          "properties": {
            "path": {"const": "domain-universe/normalization/residuals/ipc-residual-clarification-v0.1.json"},
            "sha256": {"const": "610e36a5776bacd423fed1d926ee13c32f2eff2c98a9f4a523abc6bed59b083a"}
          }
        }
      ]
    },
    "closure_amendment": {
      "allOf": [
        {"$ref": "#/$defs/artifact"},
        {
          "properties": {
            "path": {"const": "domain-universe/NORMALIZATION_CLOSURE_AMENDMENT.md"},
            "sha256": {"const": "edc324516ffe98888e0621f1d47ff019b6ca33c7d7ebc9266f32613b3e7a6570"}
          }
        }
      ]
    },
    "closure_application": {
      "allOf": [
        {"$ref": "#/$defs/artifact"},
        {
          "properties": {
            "path": {"const": "domain-universe/normalization/closure/ipc-residual-closure-v0.1.json"},
            "sha256": {"const": "4df98da8522b17957acc49a34a160740a52487905f5b709af104c34a61269c81"}
          }
        }
      ]
    },
    "disposition_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_frame_id",
        "source_extraction",
        "source_entry_id",
        "normalization_group_id",
        "successor_closure_decision_entry_id",
        "normalization_disposition",
        "target_domain_candidate_ids",
        "rationale",
        "uncertainty"
      ],
      "properties": {
        "source_frame_id": {"type": "string", "minLength": 1},
        "source_extraction": {"$ref": "#/$defs/artifact"},
        "source_entry_id": {"type": "string", "minLength": 1},
        "normalization_group_id": {
          "anyOf": [
            {"type": "string", "pattern": "^ng-[a-f0-9]{16}$"},
            {"type": "null"}
          ]
        },
        "successor_closure_decision_entry_id": {
          "anyOf": [
            {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"},
            {"type": "null"}
          ]
        },
        "normalization_disposition": {
          "type": "string",
          "enum": [
            "candidate_created",
            "merged_into_candidate",
            "excluded_out_of_scope",
            "excluded_non_materializable",
            "unresolved"
          ]
        },
        "target_domain_candidate_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^du-cand-[0-9]{4}$"}
        },
        "rationale": {"type": "string", "minLength": 1},
        "uncertainty": {"type": "string", "minLength": 1}
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "normalization_disposition": {
                "enum": ["candidate_created", "merged_into_candidate"]
              }
            },
            "required": ["normalization_disposition"]
          },
          "then": {
            "properties": {
              "normalization_group_id": {"type": "string"},
              "successor_closure_decision_entry_id": {"const": null},
              "target_domain_candidate_ids": {"minItems": 1, "maxItems": 1}
            }
          }
        },
        {
          "if": {
            "properties": {
              "normalization_disposition": {"const": "excluded_non_materializable"}
            },
            "required": ["normalization_disposition"]
          },
          "then": {
            "properties": {
              "normalization_group_id": {"const": null},
              "successor_closure_decision_entry_id": {"type": "string", "minLength": 1},
              "target_domain_candidate_ids": {"maxItems": 0}
            }
          }
        },
        {
          "if": {
            "properties": {
              "normalization_disposition": {"const": "excluded_out_of_scope"}
            },
            "required": ["normalization_disposition"]
          },
          "then": {
            "properties": {
              "normalization_group_id": {"const": null},
              "successor_closure_decision_entry_id": {"const": null},
              "target_domain_candidate_ids": {"maxItems": 0}
            }
          }
        },
        {
          "if": {
            "properties": {
              "normalization_disposition": {"const": "unresolved"}
            },
            "required": ["normalization_disposition"]
          },
          "then": {
            "properties": {
              "target_domain_candidate_ids": {"maxItems": 0}
            }
          }
        }
      ]
    }
  }
}
