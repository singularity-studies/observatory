{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/singularity-studies/observatory/schemas/domain-normalization-pass2a.schema.json",
  "title": "Domain normalization Pass 2A high-precision equivalence grouping",
  "type": "object",
  "x-instrument-version": "0.5.0-draft",
  "additionalProperties": false,
  "required": [
    "pass2a_record_id",
    "instrument_version",
    "normalization_codebook",
    "universe_boundary",
    "pass1_records",
    "procedure",
    "status",
    "groups",
    "excluded_from_grouping",
    "deferred_equivalence_questions",
    "rationale",
    "uncertainty",
    "recorded_at"
  ],
  "properties": {
    "pass2a_record_id": {"const": "equivalence-groups-v0.1"},
    "instrument_version": {"const": "0.5.0-draft"},
    "normalization_codebook": {"$ref": "#/$defs/artifact"},
    "universe_boundary": {"$ref": "#/$defs/artifact"},
    "pass1_records": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/artifact"}
    },
    "procedure": {"const": "high_precision_equivalence_grouping"},
    "status": {"const": "complete"},
    "groups": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/group"}
    },
    "excluded_from_grouping": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/excluded_member"}
    },
    "deferred_equivalence_questions": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/deferred_question"}
    },
    "rationale": {"type": "string", "minLength": 1},
    "uncertainty": {"type": "string", "minLength": 1},
    "recorded_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "member_locator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_frame_id", "source_entry_id"],
      "properties": {
        "source_frame_id": {"type": "string", "minLength": 1},
        "source_entry_id": {"type": "string", "minLength": 1}
      }
    },
    "group_member": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_frame_id",
        "pass1_record",
        "source_entry_id",
        "normalized_substantive_locus"
      ],
      "properties": {
        "source_frame_id": {"type": "string", "minLength": 1},
        "pass1_record": {"$ref": "#/$defs/artifact"},
        "source_entry_id": {"type": "string", "minLength": 1},
        "normalized_substantive_locus": {"type": "string", "minLength": 1}
      }
    },
    "deterministic_anchor": {
      "$ref": "#/$defs/member_locator"
    },
    "pairwise_equivalence_assertion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "left_member",
        "right_member",
        "same_substantive_locus",
        "equivalent_inclusion_envelope",
        "equivalent_exclusion_envelope",
        "no_material_scope_asymmetry",
        "lens_difference_only",
        "rationale",
        "uncertainty"
      ],
      "properties": {
        "left_member": {"$ref": "#/$defs/member_locator"},
        "right_member": {"$ref": "#/$defs/member_locator"},
        "same_substantive_locus": {"const": true},
        "equivalent_inclusion_envelope": {"const": true},
        "equivalent_exclusion_envelope": {"const": true},
        "no_material_scope_asymmetry": {"const": true},
        "lens_difference_only": {"const": true},
        "rationale": {"type": "string", "minLength": 1},
        "uncertainty": {"type": "string", "minLength": 1}
      }
    },
    "group": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "normalization_group_id",
        "group_kind",
        "members",
        "deterministic_anchor",
        "group_locus_statement",
        "pairwise_equivalence_assertions",
        "rationale",
        "uncertainty"
      ],
      "properties": {
        "normalization_group_id": {"type": "string", "pattern": "^ng-[a-f0-9]{16}$"},
        "group_kind": {"enum": ["singleton", "coextensive_equivalence"]},
        "members": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/group_member"}
        },
        "deterministic_anchor": {"$ref": "#/$defs/deterministic_anchor"},
        "group_locus_statement": {"type": "string", "minLength": 1},
        "pairwise_equivalence_assertions": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/pairwise_equivalence_assertion"}
        },
        "rationale": {"type": "string", "minLength": 1},
        "uncertainty": {"type": "string", "minLength": 1}
      }
    },
    "excluded_member": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_frame_id", "pass1_record", "source_entry_id", "reason"],
      "properties": {
        "source_frame_id": {"type": "string", "minLength": 1},
        "pass1_record": {"$ref": "#/$defs/artifact"},
        "source_entry_id": {"type": "string", "minLength": 1},
        "reason": {"enum": ["pass1_unresolved", "pass1_fails_out_of_scope"]}
      }
    },
    "deferred_question": {
      "type": "object",
      "additionalProperties": false,
      "required": ["left_member", "right_member", "issue", "uncertainty"],
      "properties": {
        "left_member": {"$ref": "#/$defs/member_locator"},
        "right_member": {"$ref": "#/$defs/member_locator"},
        "issue": {"type": "string", "minLength": 1},
        "uncertainty": {"type": "string", "minLength": 1}
      }
    }
  }
}
