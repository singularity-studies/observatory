{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/singularity-studies/observatory/schemas/panel-snapshot.schema.json",
  "title": "Singularity Observatory Frozen Panel snapshot",
  "type": "object",
  "x-instrument-version": "0.4.0-draft",
  "additionalProperties": false,
  "required": ["snapshot_id", "instrument_version", "status", "selection_manifest", "units"],
  "properties": {
    "snapshot_id": {"type": "string", "minLength": 1},
    "instrument_version": {"type": "string", "minLength": 1},
    "status": {"const": "frozen"},
    "selection_manifest": {"$ref": "#/$defs/artifact"},
    "units": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "panel_unit_id",
          "candidate_specification",
          "domain",
          "improvement_loop_id",
          "function_or_stage",
          "human_bottleneck_label",
          "operational_boundary",
          "continuity_rule",
          "boundary_conditions",
          "empirical_system_ids"
        ],
        "properties": {
          "panel_unit_id": {"type": "string", "minLength": 1},
          "candidate_specification": {"$ref": "#/$defs/artifact"},
          "domain": {"type": "string", "minLength": 1},
          "improvement_loop_id": {"type": "string", "minLength": 1},
          "function_or_stage": {"type": "string", "minLength": 1},
          "human_bottleneck_label": {"type": "string", "minLength": 1},
          "operational_boundary": {"type": "string", "minLength": 1},
          "continuity_rule": {"type": "string", "minLength": 1},
          "boundary_conditions": {"type": "string", "minLength": 1},
          "empirical_system_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          }
        }
      }
    }
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    }
  }
}
