{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/singularity-studies/observatory/schemas/panel-snapshot.schema.json",
  "title": "Singularity Observatory Frozen Panel snapshot",
  "type": "object",
  "x-instrument-version": "0.2.0-draft",
  "additionalProperties": false,
  "required": ["snapshot_id", "instrument_version", "status", "units"],
  "properties": {
    "snapshot_id": {"type": "string", "minLength": 1},
    "instrument_version": {"type": "string", "minLength": 1},
    "status": {"const": "frozen"},
    "units": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "panel_unit_id",
          "improvement_loop_id",
          "function_id",
          "human_bottleneck_label",
          "boundary_conditions",
          "empirical_system_ids"
        ],
        "properties": {
          "panel_unit_id": {"type": "string", "minLength": 1},
          "improvement_loop_id": {"type": "string", "minLength": 1},
          "function_id": {"type": "string", "minLength": 1},
          "human_bottleneck_label": {"type": "string", "minLength": 1},
          "boundary_conditions": {"type": "string", "minLength": 1},
          "empirical_system_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          }
        }
      }
    }
  }
}
