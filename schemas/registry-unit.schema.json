{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/singularity-studies/observatory/schemas/registry-unit.schema.json",
  "title": "Singularity Observatory Live Registry unit",
  "type": "object",
  "x-instrument-version": "0.2.0-draft",
  "additionalProperties": false,
  "required": [
    "registry_unit_id",
    "improvement_loop_id",
    "function_id",
    "human_bottleneck_label",
    "status",
    "added_on",
    "provenance_uri",
    "empirical_system_ids",
    "notes"
  ],
  "properties": {
    "registry_unit_id": {"type": "string", "minLength": 1},
    "improvement_loop_id": {"type": "string", "minLength": 1},
    "function_id": {"type": "string", "minLength": 1},
    "human_bottleneck_label": {"type": "string", "minLength": 1},
    "status": {
      "type": "string",
      "enum": ["candidate", "under_review", "eligible", "ineligible", "withdrawn"]
    },
    "added_on": {"type": "string", "format": "date"},
    "provenance_uri": {"type": "string", "format": "uri"},
    "empirical_system_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "notes": {"type": "string"}
  }
}
