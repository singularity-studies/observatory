{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/singularity-studies/observatory/schemas/wave-manifest.schema.json",
  "title": "Singularity Observatory Wave manifest",
  "type": "object",
  "x-instrument-version": "0.2.0-draft",
  "additionalProperties": false,
  "required": [
    "wave_id",
    "status",
    "schema_version",
    "panel_snapshot",
    "registry_snapshot",
    "instrument_locks",
    "scientific_records"
  ],
  "properties": {
    "wave_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]+$"
    },
    "status": {
      "type": "string",
      "enum": ["draft", "locked", "official"]
    },
    "schema_version": {
      "type": "string",
      "minLength": 1
    },
    "panel_snapshot": {"$ref": "#/$defs/artifact"},
    "registry_snapshot": {"$ref": "#/$defs/artifact"},
    "instrument_locks": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "protocol": {"$ref": "#/$defs/lock"},
        "panel": {"$ref": "#/$defs/lock"},
        "schema": {"$ref": "#/$defs/lock"},
        "schedule": {"$ref": "#/$defs/lock"},
        "governance": {"$ref": "#/$defs/lock"}
      }
    },
    "scientific_records": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence", "observations"],
      "properties": {
        "evidence": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/artifact"}
        },
        "observations": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/artifact"}
        }
      }
    },
    "locked_at": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "released_at": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "release_approval": {
      "type": ["string", "null"]
    }
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "lock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "locked_at", "artifacts"],
      "properties": {
        "version": {
          "type": "string",
          "minLength": 1
        },
        "locked_at": {
          "type": "string",
          "format": "date-time"
        },
        "artifacts": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/artifact"}
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {"enum": ["locked", "official"]}
        },
        "required": ["status"]
      },
      "then": {
        "required": ["locked_at"],
        "properties": {
          "locked_at": {"type": "string", "format": "date-time"},
          "instrument_locks": {
            "required": ["protocol", "panel", "schema", "schedule", "governance"]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {"const": "official"}
        },
        "required": ["status"]
      },
      "then": {
        "required": ["released_at", "release_approval"],
        "properties": {
          "released_at": {"type": "string", "format": "date-time"},
          "release_approval": {"type": "string", "minLength": 1}
        }
      }
    }
  ]
}
