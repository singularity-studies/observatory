{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/singularity-studies/observatory/schemas/domain-normalization-pass1.schema.json",
  "title": "Domain normalization Pass 1 independent interpretation",
  "type": "object",
  "x-instrument-version": "0.5.0-draft",
  "additionalProperties": false,
  "required": [
    "pass1_record_id",
    "instrument_version",
    "normalization_codebook",
    "universe_boundary",
    "source_extraction",
    "procedure",
    "status",
    "clarification_sources",
    "interpretations",
    "rationale",
    "uncertainty",
    "recorded_at"
  ],
  "properties": {
    "pass1_record_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]+$"
    },
    "instrument_version": {
      "const": "0.5.0-draft"
    },
    "normalization_codebook": {
      "$ref": "#/$defs/artifact"
    },
    "universe_boundary": {
      "$ref": "#/$defs/artifact"
    },
    "source_extraction": {
      "$ref": "#/$defs/artifact"
    },
    "procedure": {
      "const": "independent_entry_interpretation"
    },
    "status": {
      "const": "complete"
    },
    "clarification_sources": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/clarification_source"
      }
    },
    "interpretations": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/interpretation"
      }
    },
    "rationale": {
      "type": "string",
      "minLength": 1
    },
    "uncertainty": {
      "type": "string",
      "minLength": 1
    },
    "recorded_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "clarification_source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "clarification_source_id",
        "source_frame_id",
        "source_uri",
        "source_version_or_date",
        "source_reference",
        "retrieved_at",
        "sha256",
        "note"
      ],
      "properties": {
        "clarification_source_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]+$"
        },
        "source_frame_id": {
          "type": "string",
          "minLength": 1
        },
        "source_uri": {
          "type": "string",
          "format": "uri"
        },
        "source_version_or_date": {
          "type": "string",
          "minLength": 1
        },
        "source_reference": {
          "type": "string",
          "minLength": 1
        },
        "retrieved_at": {
          "type": "string",
          "format": "date-time"
        },
        "sha256": {
          "type": ["string", "null"],
          "pattern": "^[a-f0-9]{64}$"
        },
        "note": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "frame_role_stripping": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "note"],
      "properties": {
        "action": {
          "enum": ["none", "lens_removed", "unresolved"]
        },
        "note": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "interpretation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_entry_id",
        "source_entry_reference",
        "source_entry_descriptor",
        "frame_role_stripping",
        "normalized_substantive_locus",
        "minimal_gate_result",
        "evidence_basis",
        "clarification_source_ids",
        "rationale",
        "uncertainty"
      ],
      "properties": {
        "source_entry_id": {
          "type": "string",
          "minLength": 1
        },
        "source_entry_reference": {
          "type": "string",
          "minLength": 1
        },
        "source_entry_descriptor": {
          "type": "string",
          "minLength": 1
        },
        "frame_role_stripping": {
          "$ref": "#/$defs/frame_role_stripping"
        },
        "normalized_substantive_locus": {
          "type": ["string", "null"],
          "minLength": 1
        },
        "minimal_gate_result": {
          "enum": ["passes", "fails_out_of_scope", "unresolved"]
        },
        "evidence_basis": {
          "enum": [
            "title_and_parent_only",
            "official_same_classification_clarification"
          ]
        },
        "clarification_source_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        },
        "uncertainty": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "minimal_gate_result": {"const": "passes"}
            },
            "required": ["minimal_gate_result"]
          },
          "then": {
            "properties": {
              "normalized_substantive_locus": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "frame_role_stripping": {
                "properties": {
                  "action": {"const": "unresolved"}
                },
                "required": ["action"]
              }
            },
            "required": ["frame_role_stripping"]
          },
          "then": {
            "properties": {
              "minimal_gate_result": {"const": "unresolved"}
            }
          }
        },
        {
          "if": {
            "properties": {
              "evidence_basis": {"const": "title_and_parent_only"}
            },
            "required": ["evidence_basis"]
          },
          "then": {
            "properties": {
              "clarification_source_ids": {"maxItems": 0}
            }
          }
        },
        {
          "if": {
            "properties": {
              "evidence_basis": {
                "const": "official_same_classification_clarification"
              }
            },
            "required": ["evidence_basis"]
          },
          "then": {
            "properties": {
              "clarification_source_ids": {"minItems": 1}
            }
          }
        }
      ]
    }
  }
}
