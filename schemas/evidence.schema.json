{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/singularity-studies/observatory/schemas/evidence.schema.json",
  "title": "Singularity Observatory evidence record",
  "type": "object",
  "x-instrument-version": "0.3.0-draft",
  "additionalProperties": false,
  "required": [
    "evidence_id",
    "schema_version",
    "panel_unit_id",
    "empirical_system_ids",
    "source_uri",
    "source_title",
    "source_type",
    "observed_at",
    "retrieved_at",
    "recorded_by",
    "content_sha256",
    "relation",
    "source_statement",
    "interpretation"
  ],
  "properties": {
    "evidence_id": {
      "type": "string",
      "minLength": 1
    },
    "schema_version": {
      "type": "string",
      "minLength": 1
    },
    "panel_unit_id": {
      "type": "string",
      "minLength": 1
    },
    "empirical_system_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "source_uri": {
      "type": "string",
      "format": "uri"
    },
    "source_title": {
      "type": "string",
      "minLength": 1
    },
    "source_type": {
      "type": "string",
      "enum": [
        "primary_document",
        "official_dataset",
        "system_record",
        "scholarly_work",
        "news_report",
        "other"
      ]
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "retrieved_at": {
      "type": "string",
      "format": "date-time"
    },
    "recorded_by": {
      "type": "string",
      "minLength": 1
    },
    "content_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "archived_uri": {
      "type": ["string", "null"],
      "format": "uri"
    },
    "relation": {
      "type": "string",
      "enum": ["supports", "contradicts", "contextualizes"]
    },
    "source_statement": {
      "type": "string",
      "minLength": 1
    },
    "interpretation": {
      "type": "string"
    },
    "access_notes": {
      "type": "string"
    }
  }
}
