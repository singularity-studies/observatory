{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/singularity-studies/observatory/schemas/domain-universe-review.schema.json",
  "title": "Domain Universe scientific review",
  "type": "object",
  "x-instrument-version": "0.5.0-draft",
  "additionalProperties": false,
  "required": ["domain_universe_review_id", "instrument_version", "review_type", "domain_universe_proposal", "outcome", "rationale", "responsible_role_id", "reviewed_at"],
  "properties": {
    "domain_universe_review_id": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"},
    "instrument_version": {"type": "string", "minLength": 1},
    "review_type": {"const": "domain_universe_scientific_review"},
    "domain_universe_proposal": {"$ref": "#/$defs/artifact"},
    "outcome": {"type": "string", "enum": ["approved", "rejected", "unresolved", "pending"]},
    "rationale": {"type": "string", "minLength": 1},
    "responsible_role_id": {"type": "string", "minLength": 1},
    "reviewed_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "artifact": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    }
  }
}
