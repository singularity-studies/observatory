{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/singularity-studies/observatory/schemas/domain-universe-proposal.schema.json",
  "title": "Domain Universe proposal",
  "type": "object",
  "x-instrument-version": "0.5.0-draft",
  "additionalProperties": false,
  "required": [
    "domain_universe_proposal_id", "instrument_version", "proposal_type",
    "universe_boundary", "source_frames", "source_extractions", "domain_candidates",
    "eligibility_decisions", "domain_relations",
    "overlap_duplication_review", "coverage_audit", "domain_dispositions",
    "included_domain_candidate_ids", "created_at"
  ],
  "properties": {
    "domain_universe_proposal_id": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"},
    "instrument_version": {"type": "string", "minLength": 1},
    "proposal_type": {"const": "domain_universe"},
    "universe_boundary": {"$ref": "#/$defs/artifact"},
    "source_frames": {
      "type": "array", "minItems": 2, "uniqueItems": true,
      "items": {"$ref": "#/$defs/artifact"}
    },
    "source_extractions": {
      "type": "array", "minItems": 2, "uniqueItems": true,
      "items": {"$ref": "#/$defs/artifact"}
    },
    "domain_candidates": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"$ref": "#/$defs/artifact"}
    },
    "eligibility_decisions": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"$ref": "#/$defs/artifact"}
    },
    "domain_relations": {
      "type": "array", "uniqueItems": true,
      "items": {"$ref": "#/$defs/artifact"}
    },
    "overlap_duplication_review": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "candidate_pair_assessments", "rationale", "uncertainty"],
      "properties": {
        "status": {"type": "string", "enum": ["incomplete", "complete"]},
        "candidate_pair_assessments": {
          "type": "array", "uniqueItems": true,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["left_domain_candidate_id", "right_domain_candidate_id", "assessment", "relation_ids", "rationale"],
            "properties": {
              "left_domain_candidate_id": {"type": "string", "minLength": 1},
              "right_domain_candidate_id": {"type": "string", "minLength": 1},
              "assessment": {"type": "string", "enum": ["distinct", "overlap_documented", "duplicate_resolved", "duplicate_unresolved"]},
              "relation_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
              "rationale": {"type": "string", "minLength": 1}
            }
          }
        },
        "rationale": {"type": "string", "minLength": 1},
        "uncertainty": {"type": "string", "minLength": 1}
      }
    },
    "coverage_audit": {
      "type": "object", "additionalProperties": false,
      "required": ["audit_version", "status", "represented_activity", "potentially_missing_activity", "heavy_overlap", "single_frame_dependence", "unstable_or_technology_specific", "fashionable_ai_privilege", "overall_rationale", "overall_uncertainty"],
      "properties": {
        "audit_version": {"type": "string", "minLength": 1},
        "status": {"type": "string", "enum": ["incomplete", "complete"]},
        "represented_activity": {"$ref": "#/$defs/audit_answer"},
        "potentially_missing_activity": {"$ref": "#/$defs/audit_answer"},
        "heavy_overlap": {"$ref": "#/$defs/audit_answer"},
        "single_frame_dependence": {"$ref": "#/$defs/audit_answer"},
        "unstable_or_technology_specific": {"$ref": "#/$defs/audit_answer"},
        "fashionable_ai_privilege": {"$ref": "#/$defs/audit_answer"},
        "overall_rationale": {"type": "string", "minLength": 1},
        "overall_uncertainty": {"type": "string", "minLength": 1}
      }
    },
    "domain_dispositions": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["domain_candidate_id", "disposition", "rationale", "uncertainty"],
        "properties": {
          "domain_candidate_id": {"type": "string", "minLength": 1},
          "disposition": {"type": "string", "enum": ["included", "excluded"]},
          "rationale": {"type": "string"},
          "uncertainty": {"type": "string"}
        }
      }
    },
    "included_domain_candidate_ids": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "created_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "artifact": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "audit_answer": {
      "type": "object", "additionalProperties": false,
      "required": ["finding", "uncertainty"],
      "properties": {
        "finding": {"type": "string", "minLength": 1},
        "uncertainty": {"type": "string", "minLength": 1}
      }
    }
  }
}
