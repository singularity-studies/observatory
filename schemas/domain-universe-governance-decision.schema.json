{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/singularity-studies/observatory/schemas/domain-universe-governance-decision.schema.json",
  "title": "Domain Universe governance decision",
  "type": "object",
  "x-instrument-version": "0.5.0-draft",
  "additionalProperties": false,
  "required": ["domain_universe_governance_decision_id", "instrument_version", "decision_type", "domain_universe_proposal", "scientific_review", "outcome", "rationale", "responsible_authority_id", "recorded_at"],
  "properties": {
    "domain_universe_governance_decision_id": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"},
    "instrument_version": {"type": "string", "minLength": 1},
    "decision_type": {"const": "domain_universe_lock_authorization"},
    "domain_universe_proposal": {"$ref": "#/$defs/artifact"},
    "scientific_review": {"$ref": "#/$defs/artifact"},
    "outcome": {"type": "string", "enum": ["authorized", "unauthorized", "blocked", "unresolved", "pending"]},
    "rationale": {"type": "string", "minLength": 1},
    "responsible_authority_id": {"type": "string", "minLength": 1},
    "recorded_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "artifact": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    }
  }
}
